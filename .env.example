# Copy to .env and fill in from your Supabase project:
#   Project Settings → Data API → Project URL
#   Project Settings → API Keys → anon / public
#
# The anon key is safe in a browser bundle — row-level security is what
# protects the data. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
